<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TrackChest</AssemblyName>
    <!-- Version of the app: compared with the latest GitHub release by the updater. Change it with Publier-Version.ps1. -->
    <Version>1.1.6</Version>
    <RootNamespace>ChestCounter</RootNamespace>
    <PublishTrimmed>false</PublishTrimmed>
    <ApplicationIcon>..\..\assets\TrackChest.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\TrackChest.ico" LogicalName="TrackChest.ico" />
    <!-- Texts of the languages added after the first 16 (LangExtra.cs) -->
    <EmbeddedResource Include="Lang\*.json" LogicalName="lang-%(Filename).json" />
    <!-- Icons of the software itself (Chest, Treasures, Pirate Token) -->
    <EmbeddedResource Include="..\..\assets\Icon\Logiciel\Chest.png" LogicalName="icon-software-chest.png" />
    <EmbeddedResource Include="..\..\assets\Icon\Logiciel\Treasures.png" LogicalName="icon-software-treasures.png" />
    <EmbeddedResource Include="..\..\assets\Icon\Logiciel\Pirate_Token.png" LogicalName="icon-software-pirate_token.png" />
    <!-- Icons for the detailed statistics add-on counters -->
    <EmbeddedResource Include="..\..\assets\Icon\Addons\break_chest.png" LogicalName="icon-addon-break_chest.png" />
    <EmbeddedResource Include="..\..\assets\Icon\Addons\Esprit_Chest.png" LogicalName="icon-addon-esprit_chest.png" />
    <EmbeddedResource Include="..\..\assets\Icon\Addons\Wanted_Card.png" LogicalName="icon-addon-wanted_card.png" />
    <EmbeddedResource Include="..\..\assets\Icon\Addons\Loot_Cannons.png" LogicalName="icon-addon-loot_cannons.png" />
    <!-- Public key of the add-on catalog (made by the addon-keygen option) and its default address: optional files. -->
    <EmbeddedResource Include="..\..\assets\addon-public.key" LogicalName="addon-public.key" Condition="Exists('..\..\assets\addon-public.key')" />
    <EmbeddedResource Include="..\..\assets\addon-catalog.txt" LogicalName="addon-catalog.txt" Condition="Exists('..\..\assets\addon-catalog.txt')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\lib\FortniteReplayReader\FortniteReplayReader.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- JavaScript interpreter for script add-ons, run in a sandbox (no .NET access, time and memory limits). MIT license. -->
    <PackageReference Include="Jint" Version="4.16.4" />
  </ItemGroup>
</Project>
